 "info": {
  "description": "\nRead-only API for BrisPulse: live public transport conditions in South East Queensland.\n\nEvery response has the same envelope: `data`, and `meta` describing how fresh the\nunderlying feeds are. A value that cannot be given is `null`, never `0`; `meta.notes`\nsays why.\n\nContains Translink data \u00a9 State of Queensland (Department of Transport and Main Roads),\nlicensed under CC BY 4.0. BrisPulse is independent and not endorsed by Translink.\n",
  "title": "BrisPulse",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/v1/alerts": {
   "get": {
    "description": "Service alerts, active ones first.",
    "operationId": "get_alerts_api_v1_alerts_get",
    "parameters": [
     {
      "in": "query",
      "name": "active",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "title": "Active"
      }
     },
     {
      "in": "query",
      "name": "route_id",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Route Id"
      }
     },
     {
      "in": "query",
      "name": "stop_id",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Stop Id"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Envelope_list_AlertOut__"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     },
     "503": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "The service is not ready yet."
     }
    },
    "summary": "Get Alerts"
   }
  },
