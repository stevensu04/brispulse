# Copy to .env for local development. Never commit .env.
#
# DATABASE_URL is optional. Leave it out to run live-only: no database, no history.
# Set it to record history. The credentials below belong to the local docker-compose
# database only.
DATABASE_URL=postgresql://brispulse:brispulse@localhost:5432/brispulse

# Optional overrides (defaults shown)
# BRISPULSE_TRANSLINK_BASE_URL=https://gtfsrt.api.translink.com.au
# BRISPULSE_USER_AGENT=BrisPulse/0.1 (+https://github.com/stevensu04/brispulse)
# BRISPULSE_LOG_LEVEL=INFO
# BRISPULSE_COLLECTOR_ENABLED=true
# BRISPULSE_POLL_VEHICLE_POSITIONS_SECONDS=30
# BRISPULSE_POLL_TRIP_UPDATES_SECONDS=60
# BRISPULSE_POLL_ALERTS_SECONDS=120
# BRISPULSE_HISTORY_ENABLED=true
